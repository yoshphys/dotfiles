#!/usr/bin/env bash
# Editor side of edit-in-app. Runs inside the throwaway Ghostty window and sends
# the result back to the app the text came from.
#
#   :wq / :x  commit
#   :q!       discard: nothing was written, so nothing is sent back
#   :cq       discard after having saved, by exiting non-zero
set -uo pipefail

export PATH="/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

base="$1"
app=$(cat "$base.app")

front_bundle() {
  lsappinfo info -only bundleid "$(lsappinfo front)" 2>/dev/null | sed 's/.*=//; s/"//g'
}

# Prose for a mail or a web form, not code, and the global config turns wrap off.
@nvim@ -c 'setlocal wrap linebreak' "$base.md"
code=$?

# Command substitution drops the trailing newline nvim adds: pasting that into a
# single-line field would commit the form.
text=$(cat "$base.md")

# Nothing to send back: discarded, or saved without writing anything.
if [ "$code" -ne 0 ] || [ -z "$text" ]; then
  open -b "$app"
  exit 0
fi

saved=$(pbpaste)
printf '%s' "$text" | pbcopy

# LaunchServices, so bringing the app back needs no automation permission.
open -b "$app"

# Paste only once the originating app is really frontmost. A stray Cmd-V into
# the wrong app is worse than leaving the text on the clipboard.
for _ in $(seq 1 25); do
  [ "$(front_bundle)" = "$app" ] && break
  sleep 0.2
done

if [ "$(front_bundle)" = "$app" ]; then
  osascript -e 'tell application "System Events" to keystroke "v" using command down' >/dev/null 2>&1
  sleep 0.8
  printf '%s' "$saved" | pbcopy
else
  printf '%s\n' "edit-in-app: $app never came to the front." \
                "The edited text is on the clipboard; paste it with Cmd-V." \
                "A copy is kept at $base.md" >&2
  sleep 5
fi
